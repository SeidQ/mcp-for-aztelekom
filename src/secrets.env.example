# Bu faylı "secrets.env" adı ilə kopyalayın (setup.bat bunu avtomatik edir) və öz məlumatlarınızı yazın.
# secrets.env git-ə düşmür (.gitignore). Heç kimə göndərməyin.
# Dəyişəndən sonra Claude desktop-u yenidən açın.

# Portal (portal-ui, sv-desktop)
PORTAL_USER=
PORTAL_PASS=

# TFS (tfs-defects). TFS_AUTH: ntlm | basic | pat
TFS_AUTH=ntlm
TFS_USER=
TFS_PASSWORD=

# Defect monitor (istəyə bağlı): test məktubları bu ünvana gedir
MONITOR_ME=
# TestRail (testrail MCP server)
TESTRAIL_URL=https://azercelltelecom.testrail.io
TESTRAIL_USER=name.surname@azercell.com
TESTRAIL_API_KEY=<My Settings -> API Keys>
TESTRAIL_PROJECT=aztelekom
