# Copy to bss.env (gitignored) and fill in. Environment variables override this file.

# --- Connection (required)
BSS_BASE_URL=https://<bss-host>/<prefix>      # without /v1, e.g. https://bss-test.example.az
BSS_VERIFY_SSL=1                              # 0 for self-signed test certificates
BSS_TIMEOUT=30
# Auth is not described in the swagger. If needed, give the full header:
# BSS_AUTH_HEADER=Authorization: Bearer <token>
BSS_AUTH_HEADER=

# --- Read test data (tests needing a missing value are skipped)
BSS_ACCOUNT_NUMBER=          # existing account number
BSS_ALIAS_NUMBER=            # alias (e.g. phone number) of the same account
BSS_ACCOUNT_ID=              # id of an existing account
BSS_PAYMENT_ID=              # id of an existing payment
BSS_TRANSACTION_ID=          # transactionId (UUID) of an existing payment
BSS_PAYMENT_DATE=            # YYYY-MM-DD with at least one payment

# --- Write tests (POST /v1/payment creates REAL payments)
BSS_ALLOW_WRITE=0            # 1 only on a test environment
BSS_WRITE_ACCOUNT_NUMBER=    # test account that may receive payments

# --- Other
BSS_MAX_MS=3000              # response time limit for performance tests
BSS_STRICT_SCHEMA=0          # 1 = undocumented response fields fail the contract check
BSS_NO_REPORT=0              # 1 = do not write the Excel report
